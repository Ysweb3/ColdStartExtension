{
  "manifest_version": 3,
  "name": "coldstart",
  "version": "1.0.0",
  "description": "Captures your open tabs for the coldstart desktop app",
  "host_permissions": ["http://localhost:8765/*"],
  "permissions": ["tabs", "alarms", "identity", "identity.email","storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Send tabs to coldstart",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
